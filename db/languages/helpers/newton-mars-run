#!/usr/local/python-3.13.1/bin/python3
"""Run MARS and capture its optional end-of-run state as a Judge0 asset."""

import os
import re
import subprocess
import sys
from pathlib import Path

REGISTERS = (
    "zero at v0 v1 a0 a1 a2 a3 t0 t1 t2 t3 t4 t5 t6 t7 "
    "s0 s1 s2 s3 s4 s5 s6 s7 t8 t9 k0 k1 gp sp fp ra"
).split()
REGISTER_NUMBERS = {name.encode(): index for index, name in enumerate(REGISTERS)}
STATE_LINE = re.compile(rb"^(?:\$[a-z][a-z0-9]*|Mem\[0x[0-9a-fA-F]+\])\t")
MARS = [
    "/usr/local/bin/java",
    "-Djava.util.logging.config.file=/usr/local/mars/logging.properties",
    "-jar",
    "/usr/local/mars/mars.jar",
    "nc",
]

arguments = sys.argv[1:]
has_me = False
for argument in arguments:
    if argument.lower() == "pa":
        break
    if argument.lower() == "me":
        has_me = True

if not has_me:
    # Let bash observe Java's exit status and signals directly.
    os.execv(MARS[0], [*MARS, "main.s", *arguments])

# MARS sends the post-mortem dump and its error messages to stderr with `me`.
# ae1/se1 make assembly and runtime failures nonzero instead of Accepted.
command = [*MARS, "ae1", "se1", "main.s", *arguments]
state_path = Path("mars-state.txt")
state_file = None
try:
    with subprocess.Popen(command, stderr=subprocess.PIPE) as process:
        for line in process.stderr:
            if STATE_LINE.match(line):
                name, _, value = line.partition(b"\t")
                if name.startswith(b"$") and name[1:] in REGISTER_NUMBERS:
                    name = f"${REGISTER_NUMBERS[name[1:]]} (".encode() + name + b")"
                if state_file is None:
                    state_file = state_path.open("wb", buffering=0)
                state_file.write(name + b"\t" + value)
            elif (
                line.startswith(b"Program terminated when maximum step limit ")
                and line.rstrip().endswith(b" reached.")
            ):
                # `me` moves this MARS notice to stderr; the old lane showed it on stdout.
                sys.stdout.buffer.write(b"\n" + line + b"\n")
                sys.stdout.buffer.flush()
            elif line.strip():
                sys.stderr.buffer.write(line)
                sys.stderr.buffer.flush()
        returncode = process.wait()
finally:
    if state_file is None:
        state_path.unlink(missing_ok=True)
    else:
        state_file.close()

sys.exit(returncode if returncode >= 0 else 128 - returncode)
